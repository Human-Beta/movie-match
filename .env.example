# Server-only PostgreSQL connection for docker-compose.example.yml.
# Replace it with the appropriate connection URL from Supabase Connect when using a hosted project.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/movie_match

# Browser-safe Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<replace-me>

# Local-only PostgreSQL container settings used by docker-compose.example.yml.
POSTGRES_DB=movie_match
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=54322
