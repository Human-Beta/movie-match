{
  "name": "movie-match",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "packageManager": "pnpm@11.0.9",
  "scripts": {
    "dev": "next dev",
    "dev:https": "bash scripts/dev-https.sh",
    "dev:local": "docker compose --env-file .env.local up -d --wait postgres && pnpm db:migrate && next dev",
    "build": "next build --webpack",
    "start": "next start",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test": "tsx --test",
    "test:coverage": "node --import tsx --test --experimental-test-coverage",
    "test:join:db": "tsx --conditions=react-server --test lib/participants/participant-repository.integration.ts",
    "test:participants:db": "tsx --conditions=react-server --test lib/participants/participant-repository.integration.ts lib/participants/participant-snapshot-repository.integration.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck",
    "verify": "pnpm check && pnpm test && pnpm build",
    "prepare": "husky"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.3",
    "drizzle-orm": "0.45.2",
    "next": "16.3.1",
    "next-intl": "4.13.7",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-qr-code": "2.2.0",
    "server-only": "0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "dotenv": "17.4.2",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.2",
    "eslint-config-next": "16.3.1",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "6.0.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md}": "prettier --write"
  }
}
